{
    "id": "hr",
    "schemaVersion": "1.1.0",
    "name": "HR",
    "revision": "1",
    "type": "task",
    "readOnly": false,
    "content": [
        {
            "id": "ticket_detail",
            "type": "section",
            "title": "Ticket Details",
            "content": [
                {
                    "id": "requester",
                    "type": "string",
                    "label": "Requester",
                    "readOnly": true,
                    "value": "${context.requester}",
                    "constraints": {
                        "required": false
                    }
                },
                {
                    "id": "ticket_type",
                    "type": "string",
                    "label": "Ticket Type",
                    "readOnly": true,
                    "value": "${context.TicketType}",
                    "constraints": {
                        "required": false
                    }
                },
                {
                    "id": "description",
                    "type": "string",
                    "label": "Description",
                    "readOnly": true,
                    "value": "${context.Description}",
                    "control": {
                        "type": "TextArea",
                        "properties": {
                            "height": "medium"
                        }
                    },
                    "constraints": {
                        "required": false
                    }
                }
            ]
        },
        {
            "id": "support_details",
            "type": "section",
            "title": "Support Details",
            "content": [
                {
                    "id": "name",
                    "type": "string",
                    "label": "Name",
                    "readOnly": true,
                    "value": "${context.Support_User[0].fullname}",
                    "constraints": {
                        "required": false
                    }
                },
                {
                    "id": "email",
                    "type": "string",
                    "label": "Email",
                    "readOnly": true,
                    "value": "${context.Support_User[0].email}",
                    "constraints": {
                        "required": false
                    }
                },
                {
                    "id": "designation",
                    "type": "string",
                    "label": "Designation",
                    "readOnly": true,
                    "value": "${context.Support_User[0].designation}",
                    "constraints": {
                        "required": false
                    }
                }
            ]
        }
    ],
    "decisions": [
        {
            "id": "approve",
            "text": "Approve",
            "decisionType": "positive"
        },
        {
            "id": "reject",
            "text": "Reject",
            "decisionType": "negative"
        },
        {
            "id": "rework",
            "text": "Send back to Requester",
            "decisionType": ""
        }
    ]
}